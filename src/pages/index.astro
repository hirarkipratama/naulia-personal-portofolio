---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import MobileBottomDock from '../components/sections/MobileBottomDock.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import AudioShowcaseSection from '../components/sections/AudioShowcaseSection.astro';
import EditorialSection from '../components/sections/EditorialSection.astro';
import EventSection from '../components/sections/EventSection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import Footer from '../components/sections/Footer.astro';
import AmbientGlows from '../components/common/AmbientGlows.astro';

import {
  availabilityData,
  heroData,
  audioTracks,
  bookProjects,
  statItems,
  eventHighlights,
  clientPartners,
  aboutData,
  contactData
} from '../lib/content';
---

<BaseLayout
  title="Naulia Zahra — Portofolio Kreatif & Editorial"
  description="Portofolio resmi Naulia Zahra: Editor Buku Anak & Sains, Pemandu Panggung & MC Acara Resmi Gramedia, serta Narator Voice Over Ekspresif."
>
  <!-- Fixed Top Header -->
  <Header availability={availabilityData} />

  <!-- Main Landmark Flow -->
  <main class="w-full pt-16 md:pt-20 bg-surface min-h-[calc(100vh-20rem)] overflow-x-hidden relative">
    <div class="relative w-full max-w-[1280px] mx-auto px-margin-mobile md:px-margin pt-space-md pb-space-xl">
      <!-- Ambient Decorative Backdrop Glows -->
      <AmbientGlows />

      <!-- 1. Hero Section (#home) -->
      <HeroSection hero={heroData} />

      <!-- 2. Audio Showcase Repertoire (#voice-audio-reel / alias #audio) -->
      <AudioShowcaseSection tracks={audioTracks} />

      <!-- 3. Editorial Literature & Book Portfolio (#editorial-portfolio) -->
      <EditorialSection books={bookProjects} />

      <!-- 4. MC Stage & Live Moderation (#mc-live-stage) -->
      <EventSection
        stats={statItems}
        events={eventHighlights}
        partners={clientPartners}
      />

      <!-- 5. Editorial Philosophy & About Naulia (#about-naulia) -->
      <AboutSection about={aboutData} />

      <!-- 6. Collaboration Booking & Contact (#contact) -->
      <ContactSection contact={contactData} />
    </div>
  </main>

  <!-- Expanded Multi-column Footer -->
  <Footer />

  <!-- Fixed Mobile Bottom Dock (<1024px) -->
  <MobileBottomDock />
</BaseLayout>
