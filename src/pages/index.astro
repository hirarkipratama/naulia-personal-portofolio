---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Naulia Zahra — Book Editor, MC & Voice-Over Artist"
  description="Personal portfolio of Naulia Zahra: Book Editor, Live Stage MC, and Voice-Over Artist."
>
  <main class="relative min-h-screen overflow-x-hidden px-4 py-16 sm:px-8 md:px-12 lg:px-16">
    <!-- Ambient decorative backdrop glow -->
    <div
      class="pointer-events-none absolute -top-24 -left-24 h-96 w-96 rounded-full bg-primary-container/20 blur-3xl"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute top-1/2 -right-24 h-80 w-80 rounded-full bg-secondary-fixed/30 blur-3xl"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto flex max-w-[1280px] flex-col items-start gap-8 py-12 md:py-20">
      <!-- Availability / Discipline Pill -->
      <div class="inline-flex items-center gap-2 rounded-full border border-outline-variant/60 bg-surface-container-low px-4 py-1.5 text-xs font-semibold tracking-wider uppercase text-on-surface-variant shadow-xs">
        <span
          class="h-2 w-2 rounded-full bg-tertiary animate-pulse"
          aria-hidden="true"
        ></span>
        <span>Creative Portfolio &bull; Phase 1 Foundation</span>
      </div>

      <!-- Headline -->
      <div class="space-y-4">
        <h1 class="font-headline font-semibold text-4xl tracking-tight sm:text-5xl md:text-6xl lg:text-7xl text-primary">
          Naulia Zahra
        </h1>
        <p class="max-w-2xl font-body text-lg text-on-surface-variant md:text-xl">
          Children’s & Science Book Editor, Dynamic Event MC & Moderator, and
          Expressive Voice-Over Artist crafting stories across print, stage, and
          audio.
        </p>
      </div>

      <!-- Actions / Placeholder CTA -->
      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a
          href="mailto:contact@nauliazahra.com"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-secondary-container px-6 py-3.5 font-headline font-semibold text-on-secondary-container shadow-md transition-all hover:bg-secondary-fixed hover:scale-[1.02] active:scale-95"
        >
          <span>Get in Touch</span>
          <span class="material-symbols-outlined text-lg" aria-hidden="true">
            arrow_forward
          </span>
        </a>
        <a
          href="#about"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-outline-variant bg-surface-container-lowest px-6 py-3.5 font-body font-medium text-on-surface shadow-xs transition-all hover:bg-surface-container-low active:scale-95"
        >
          <span>Explore Works</span>
        </a>
      </div>

      <!-- Status Info Card -->
      <section
        aria-label="Implementation Status"
        class="mt-12 w-full max-w-xl rounded-2xl border border-outline-variant/70 bg-surface-container-lowest p-6 shadow-sm"
      >
        <h2 class="font-headline font-semibold text-lg text-on-surface">
          Foundation Ready
        </h2>
        <p class="mt-1 font-body text-sm text-on-surface-variant">
          Phase 1 project foundation is active with Astro, TypeScript strict
          checking, and Tailwind CSS v4 Curated Lumina tokens.
        </p>
        <div class="mt-4 flex flex-wrap gap-2 text-xs font-medium text-on-surface-variant">
          <span class="rounded-full bg-surface-container px-3 py-1">
            Astro v7
          </span>
          <span class="rounded-full bg-surface-container px-3 py-1">
            Tailwind CSS v4
          </span>
          <span class="rounded-full bg-surface-container px-3 py-1">
            TypeScript Strict
          </span>
          <span class="rounded-full bg-surface-container px-3 py-1">
            ESLint + Prettier
          </span>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
