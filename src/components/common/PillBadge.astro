---
interface Props {
  text: string;
  icon?: string;
  variant?: 'primary' | 'secondary' | 'tertiary' | 'neutral' | 'dark' | 'glass';
  size?: 'sm' | 'md';
  className?: string;
}

const {
  text,
  icon,
  variant = 'neutral',
  size = 'sm',
  className = ''
} = Astro.props;

const variantClasses = {
  primary: 'bg-primary-container text-on-primary-container font-bold shadow-xs',
  secondary: 'bg-secondary-fixed text-on-secondary-fixed font-bold shadow-xs',
  tertiary: 'bg-tertiary-fixed text-on-tertiary-fixed font-bold shadow-xs',
  neutral: 'bg-surface-container text-on-surface-variant',
  dark: 'bg-inverse-surface/80 text-inverse-on-surface backdrop-blur-sm',
  glass: 'bg-surface/90 text-on-surface backdrop-blur-md shadow-xs'
}[variant];

const sizeClasses = {
  sm: 'px-2.5 py-1 text-label-sm font-label-sm',
  md: 'px-3.5 py-1.5 text-label-md font-label-md'
}[size];
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full transition-transform',
    variantClasses,
    sizeClasses,
    className
  ]}
>
  {icon && (
    <span class="material-symbols-outlined text-[16px]" aria-hidden="true">
      {icon}
    </span>
  )}
  <span>{text}</span>
</span>
