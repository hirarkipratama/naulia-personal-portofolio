---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class:list={['pointer-events-none absolute inset-0 overflow-hidden', className]} aria-hidden="true">
  <!-- Coral Glow Bubble -->
  <div class="absolute -top-16 -left-20 w-96 h-96 bg-primary-container/20 rounded-full blur-3xl"></div>
  <!-- Sunlight Yellow Glow Bubble -->
  <div class="absolute top-32 right-0 w-80 h-80 bg-secondary-fixed/30 rounded-full blur-3xl"></div>
  <!-- Mint Aqua Glow Bubble -->
  <div class="absolute top-96 left-1/3 w-64 h-64 bg-tertiary-fixed/30 rounded-full blur-3xl"></div>
</div>
