---
import type { HeroData } from '../../types/portfolio';
import Button from '../common/Button.astro';

interface Props {
  hero: HeroData;
}

const { hero } = Astro.props;
---

<section
  class="relative grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-center pt-space-xs mb-space-xl scroll-mt-24"
  id="home"
>
  <!-- Left Column: Typography & Action -->
  <div class="lg:col-span-7 flex flex-col items-start gap-space-md z-10">
    <!-- Status Pill (Mobile & Desktop) -->
    <div class="flex items-center gap-2 hero-animate delay-1">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-tertiary-fixed/30 text-on-tertiary-fixed shadow-xs">
        <span class="w-2 h-2 rounded-full bg-tertiary animate-pulse" aria-hidden="true"></span>
        <span class="font-label-sm text-label-sm font-semibold tracking-wide uppercase">
          {hero.statusGreeting}
        </span>
      </div>
      <span class="font-label-sm text-label-sm text-on-surface-variant">
        {hero.location}
      </span>
    </div>

    <!-- Main Headline -->
    <h1 class="font-display-hero text-headline-lg-mobile md:text-headline-lg lg:text-display-hero text-on-surface tracking-tight max-w-2xl leading-tight">
      {hero.headline}{' '}
      <span class="text-primary italic font-normal">
        {hero.headlineHighlight}
      </span>{' '}
      Bernyawa di Panggung.
    </h1>

    <!-- Subtitle & Hybrid Discipline Description -->
    <div class="flex flex-col gap-space-xs">
      <p class="font-body-lg text-body-md md:text-body-lg text-on-surface-variant font-medium">
        {hero.disciplines}
      </p>
      <p class="font-body-md text-body-sm md:text-body-md text-on-surface-variant/90 max-w-xl">
        {hero.subdescription}
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-space-sm pt-space-xs w-full sm:w-auto">
      <Button
        href={hero.primaryCta.href}
        variant="primary"
        icon="arrow_forward"
        className="w-full sm:w-auto text-center"
      >
        {hero.primaryCta.label}
      </Button>

      <Button
        href={hero.secondaryCta.href}
        variant="secondary"
        icon="play_circle"
        iconPosition="left"
        className="w-full sm:w-auto text-center"
      >
        {hero.secondaryCta.label}
      </Button>
    </div>

    <!-- Trust Badges Bar -->
    <div class="flex flex-wrap items-center gap-space-xs pt-space-xs">
      {hero.trustBadges.map((badge, idx) => {
        const iconColors = ['text-secondary', 'text-primary', 'text-tertiary'];
        const iconColor = iconColors[idx % iconColors.length];
        return (
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-container-low shadow-xs">
            <span class:list={['material-symbols-outlined text-[18px]', iconColor]} aria-hidden="true">
              {badge.icon}
            </span>
            <span class="font-label-md text-label-sm md:text-label-md text-on-surface font-semibold">
              {badge.text}
            </span>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Right Column: Visual Stage & Studio Deck -->
  <div class="lg:col-span-5 relative flex flex-col items-center w-full">
    <!-- Portrait Container with Nested Depth -->
    <div class="relative w-full aspect-[4/5] max-h-[460px] rounded-3xl overflow-hidden bg-surface-container-high shadow-[0_20px_40px_-8px_rgba(28,26,23,0.08)] group">
      <img
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
        src={hero.portraitImage}
        alt={hero.portraitAlt}
        loading="eager"
        decoding="async"
        width="640"
        height="800"
      />

      <!-- Subtle Gradient Scrim -->
      <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface/75 via-transparent to-transparent pointer-events-none"></div>

      <!-- Overlaid Floating Badge & Scrim Info -->
      <div class="absolute bottom-4 left-5 right-5 text-inverse-on-surface">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface/90 text-on-surface backdrop-blur-md self-start shadow-xs mb-1">
          <span class="material-symbols-outlined text-primary text-[16px]" style="font-variation-settings: 'FILL' 1;" aria-hidden="true">
            mic
          </span>
          <span class="font-label-sm text-label-sm uppercase tracking-wider font-semibold">
            {hero.portraitKicker}
          </span>
        </div>
        <p class="font-headline-sm text-headline-sm font-semibold text-inverse-on-surface">
          Naulia Zahra
        </p>
        <p class="font-body-sm text-body-sm text-inverse-on-surface/90">
          {hero.portraitSubtitle}
        </p>
      </div>
    </div>
  </div>
</section>
