---
import type { BookProjectItem } from '../../types/portfolio';
import PillBadge from '../common/PillBadge.astro';

interface Props {
  project: BookProjectItem;
}

const { project } = Astro.props;
---

<div
  class="book-card group flex flex-col rounded-3xl bg-surface-container-lowest p-space-sm shadow-[0_4px_16px_-2px_rgba(28,26,23,0.04)] hover:shadow-[0_12px_28px_-4px_rgba(255,142,114,0.18)] transition-all duration-300 hover:-translate-y-1 border border-outline-variant/20"
  data-category={project.category}
>
  <!-- Book Cover Image with Overlaid Badges -->
  <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden bg-surface-container-low mb-space-sm">
    <img
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      src={project.coverImage}
      alt={project.altText}
      loading="lazy"
      decoding="async"
      width="400"
      height="300"
    />

    <!-- Category Pill Top-Left -->
    <div class="absolute top-3 left-3">
      <PillBadge
        text={project.categoryLabel}
        variant={project.categoryBadgeVariant || 'secondary'}
        size="sm"
      />
    </div>

    <!-- Age Rating Pill Bottom-Right -->
    <div class="absolute bottom-3 right-3">
      <PillBadge text={project.ageRange} variant="dark" size="sm" />
    </div>
  </div>

  <!-- Meta Information -->
  <div class="flex flex-col px-space-xs pb-space-xs gap-1 flex-1">
    <p class="font-label-sm text-label-sm uppercase tracking-wider text-primary font-bold">
      {project.role}
    </p>

    <h3 class="font-headline-sm text-headline-sm text-on-surface group-hover:text-primary transition-colors font-semibold">
      {project.title}
    </h3>

    <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2">
      {project.summary}
    </p>

    <div class="flex items-center justify-between pt-space-xs mt-auto border-t border-surface-container/60">
      <span class="font-label-sm text-label-sm text-on-surface-variant/80">
        {project.publisher} • {project.pageCount} Hal
      </span>
      <span
        class="material-symbols-outlined text-primary group-hover:translate-x-1 transition-transform text-[20px]"
        aria-hidden="true"
      >
        arrow_outward
      </span>
    </div>
  </div>
</div>
